{
  "name": "auto-offline",
  "version": "1.0.0",
  "description": "Decky Loader plugin that switches your Steam friends status on a daily schedule",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "node test/schedule.test.ts"
  },
  "author": "dizmo",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imdizmo/decky-auto-offline.git"
  },
  "homepage": "https://github.com/imdizmo/decky-auto-offline#readme",
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "steam",
    "friends"
  ]
}
